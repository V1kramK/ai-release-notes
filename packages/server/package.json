{
  "name": "@release-notes/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "NODE_OPTIONS='--loader tsx/esm' node --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@release-notes/shared": "*",
    "@octokit/rest": "^21.0.2",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "jira.js": "^4.0.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "undici": "^6.20.1",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.16.1",
    "@types/uuid": "^10.0.0",
    "@types/cookie-parser": "^1.4.7",
    "typescript": "^5.5.4",
    "tsx": "^4.17.0",
    "vitest": "^2.0.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^9.9.0"
  }
}
